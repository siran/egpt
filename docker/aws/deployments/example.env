# shellcheck shell=bash disable=SC2034
# An example deployment, synthetic values. Sourced by ../lib.sh (bash); --deploy example dry-runs it.
# A real one: copy this to $EGPT_AWS_DEPLOYMENTS/<name>.env (default ~/.egpt/config/aws-deployments,
# outside the repo), edit, and pick it with --deploy <name> or EGPT_AWS_DEPLOY=<name>.
ACCOUNT=123456789012          # any other account is refused
PROFILE=example               # AWS_PROFILE, unless already set
REGION=us-east-1              # AWS_DEFAULT_REGION
PROJECT=egpt-example          # the tag on everything; nothing without it is touched
N=example                     # name prefix: cluster/service/family $N, $N-ecs-lt, $N-data, $N-sg, image egpt:$N, ...
LABEL=EXAMPLE                 # display name in descriptions and boot logs
VPC_CIDR=10.0.0.0/16          # the VPC $N-vpc, when the scripts create it
SUBNET_CIDR=10.0.1.0/24       # its one public subnet, $N-public
TYPES=(t3a.medium t3.medium)  # Spot pools; on-demand takes the first (medium: 4 GB)
ON_DEMAND=0                   # 1: on-demand without --on-demand
DATA_GB=30                    # the data volume $N-data, GB
DATA_INIT=format              # format: a blank data volume is formatted at boot; empty: never
SWAP_MB=4096                  # swap file on the ECS container instance
MEM_MIB=1024                  # memoryReservation (soft) of the egpt container
EGPT_BEEPER=off               # off, on (one Beeper), or names (primary,secondary): one Beeper per account, profiles on the data volume
LEGACY_NODE=                  # the plain-EC2 host from provision.sh (its Name), to move to ECS; empty: none, ecs-provision.sh makes the network and data volume
BUCKET=egpt-example-transfer-$ACCOUNT   # private transfer bucket (migrate.sh); the instance role may get/delete under migrate/. Empty: none
OFICINA_TUNNEL=0              # 1: the oficina-tunnel sidecar, an SSH local forward to a whisper server
OFICINA_TUNNEL_PORT=          # with OFICINA_TUNNEL=1: the tunnel host's ssh port, e.g. 22
ECR_UNTAGGED=0                # 1: ECR egpt exists without the Project tag (made by hand); build-push.sh accepts it
ZONE=                         # Route 53 private zone, ours, e.g. example.internal; found by name + tag. Empty: none
DNS_NAME=                     # with ZONE: A record the instance points at its own private IP at every boot, e.g. $N.$ZONE
ZONE_VPC=                     # with ZONE: the VPC the zone is associated with (e.g. vpc-0123456789abcdef0, a peered VPC)
SSH_PORT=                     # e.g. 2222: sshd in the container as egpt, tcp $SSH_PORT open in $N-sg, the EIP $N-ip. Empty: none
SSH_PERMIT_LISTEN=            # with SSH_PORT: "host:port ..." reverse forwards (ssh -R) may listen on, e.g. "127.0.0.1:22001"
