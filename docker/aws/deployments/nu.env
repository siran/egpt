# shellcheck shell=bash disable=SC2034
# NU: an independent node in the personal account (plans/2611020936-NU-NODE.md). --deploy nu
ACCOUNT=480854905773
PROFILE=default
REGION=us-east-1
PROJECT=egpt-nu
N=nu
LABEL=NU
VPC_CIDR=10.90.0.0/16
SUBNET_CIDR=10.90.1.0/24
TYPES=(t3a.medium t3.medium)  # small (1.9 GB) ran out of RAM; resized in place 2026-11-04
ON_DEMAND=1
DATA_GB=30
DATA_INIT=format              # starts empty; the entrypoint seeds egpt-home
SWAP_MB=4096
MEM_MIB=1024
EGPT_BEEPER=primary,secondary # one Beeper per account, profiles on the data volume (egpt-beeper, egpt-beeper-secondary)
LEGACY_NODE=                  # none: ecs-provision.sh makes the network and data volume
BUCKET=egpt-nu-transfer-$ACCOUNT   # secrets reach NU through it (private, objects deleted after the copy)
OFICINA_TUNNEL=0
ECR_UNTAGGED=0
ZONE=
DNS_NAME=
ZONE_VPC=
SSH_PORT=2222                 # ssh nu: sshd in the container as egpt; nu-sg opens it, the EIP nu-ip is its address
SSH_PERMIT_LISTEN="127.0.0.1:22115 127.0.0.1:22102 127.0.0.1:23390"   # kg / do sshd + dolly whisper worker, reverse tunnels (src/tools/nu-tunnel)
