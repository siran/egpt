# shellcheck shell=bash disable=SC2034
# EDW: EduWeb's account. Sourced by ../lib.sh (bash); --deploy edw, the default.
ACCOUNT=331665579468          # any other account is refused
PROFILE=eduweb                # AWS_PROFILE, unless already set
REGION=us-east-1
PROJECT=egpt-edw              # the tag on everything; nothing without it is touched
N=edw                         # name prefix: cluster/service/family $N, $N-ecs-lt, $N-data, $N-sg, ...
LABEL=EDW
VPC_CIDR=10.88.0.0/16
SUBNET_CIDR=10.88.1.0/24
TYPES=(t3a.medium t3.medium)  # Spot pools; on-demand takes the first (medium: 4 GB, 10-30; 2 GB thrashed)
ON_DEMAND=0                   # 1: on-demand without --on-demand
DATA_GB=30
DATA_INIT=                    # format: a blank data volume is formatted at boot; empty: never
SWAP_MB=4096
MEM_MIB=1024                  # memoryReservation (soft); t3a.small registers ~1.9 GiB
EGPT_BEEPER=off
LEGACY_NODE=edw-node          # the plain-EC2 host; its network and data volume came from provision.sh
BUCKET=egpt-edw-transfer-$ACCOUNT   # migrate.sh's transfer bucket; the instance role may read it
OFICINA_TUNNEL=1              # the oficina-tunnel sidecar
ECR_UNTAGGED=1                # ECR egpt was made by hand, untagged; build-push.sh accepts it
ZONE=egpt.internal            # Route 53 private zone, ours; found by name + tag. Empty: none
DNS_NAME=edw.$ZONE            # A record the instance points at its own private IP at every boot
ZONE_VPC=vpc-b33403d6         # EduWeb's production VPC: Portales-new proxies the chatbox to $DNS_NAME:8095
